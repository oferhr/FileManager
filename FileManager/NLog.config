<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.nlog-project.org/schemas/NLog.xsd NLog.xsd"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off" internalLogFile="c:\temp\nlog-internal.log">

  <targets>
    <!-- Main application log: all Info and above, daily rolling file under logs/ next to the executable. -->
    <target xsi:type="File"
            name="mainFile"
            fileName="${basedir}/logs/${shortdate}.log"
            layout="${longdate} | ${uppercase:${level}:padding=-5} | ${logger} | ${message} ${onexception:inner=${newline}${exception:format=tostring}}${when:when=length('${all-event-properties}')>0:inner= | ${all-event-properties}}"
            keepFileOpen="false"
            encoding="utf-8"
            archiveAboveSize="10485760"
            maxArchiveFiles="30" />

    <!-- Security-focused log: only events marked with SecurityEvent=true property. -->
    <target xsi:type="File"
            name="securityFile"
            fileName="${basedir}/logs/security-${shortdate}.log"
            layout="${longdate} | ${uppercase:${level}:padding=-5} | ${event-properties:item=EventType:whenEmpty=-} | ${message} | ${all-event-properties}"
            keepFileOpen="false"
            encoding="utf-8"
            archiveAboveSize="10485760"
            maxArchiveFiles="90" />
  </targets>

  <rules>
    <!-- Security events route to the security log first. final=false so they also reach the main log. -->
    <logger name="*" minlevel="Warn" writeTo="securityFile">
      <filters defaultAction="Ignore">
        <when condition="'${event-properties:item=SecurityEvent}' == 'True'" action="Log" />
      </filters>
    </logger>

    <!-- Everything Info and above goes to the main log. -->
    <logger name="*" minlevel="Info" writeTo="mainFile" />
  </rules>
</nlog>
